# Server configuration (packages/server/src/config.ts validates all of it at startup).
# Development needs none of these: `pnpm dev` uses the defaults shown here.
# In production (NODE_ENV=production) the first five are required and have no defaults.

NODE_ENV=development
DATABASE_URL=postgres://whiteboard:whiteboard@127.0.0.1:55432/whiteboard
REDIS_URL=redis://127.0.0.1:56379
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
# Comma-separated origins allowed for CORS and WebSocket upgrades.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PORT=3001
HOST=127.0.0.1
# Defaults to true in production. Browsers accept Secure cookies on http://localhost too.
COOKIE_SECURE=false
# true behind a reverse proxy (client IP from X-Forwarded-For).
TRUST_PROXY=false
BCRYPT_COST=12
LOG_LEVEL=info

ROOM_UNLOAD_MS=60000
SNAPSHOT_EVERY_OPS=500
SNAPSHOT_EVERY_MS=60000

AUTH_RATE_LIMIT_PER_MIN=10
WS_OPS_PER_SEC=200
WS_OPS_BURST=1000
WS_MSGS_PER_SEC=50
WS_MSGS_BURST=200
WS_MAX_SOCKETS_PER_USER=5
PRESENCE_TIMEOUT_MS=15000
PRESENCE_SWEEP_MS=5000

# Optional: require `Authorization: Bearer <token>` on /metrics.
METRICS_TOKEN=
# Optional: where the SQL migrations live (the Docker image sets /app/drizzle).
MIGRATIONS_DIR=
