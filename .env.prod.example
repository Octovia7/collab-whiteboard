# Production stack settings for docker-compose.prod.yml. Copy to .env.prod (never committed)
# and replace every value. Generate secrets with: openssl rand -base64 48

POSTGRES_PASSWORD=change-me-to-a-long-random-password
JWT_SECRET=change-me-to-at-least-32-random-characters-long
# The public origin users load the app from (CORS and the WebSocket Origin check).
APP_ORIGIN=https://board.example.com
APP_PORT=8080
# true behind HTTPS (and on http://localhost, which browsers treat as secure).
COOKIE_SECURE=true
# Optional: require `Authorization: Bearer <token>` on /metrics (internal network only anyway).
METRICS_TOKEN=
LOG_LEVEL=info
