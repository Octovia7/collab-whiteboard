{
  "name": "whiteboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:convergence": "vitest run --config vitest.convergence.config.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "build:e2e": "pnpm -F @whiteboard/server build && pnpm -F @whiteboard/client exec vite build --mode e2e",
    "test:e2e": "pnpm build:e2e && playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@whiteboard/shared": "workspace:*",
    "eslint": "^9.39.5",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  }
}
